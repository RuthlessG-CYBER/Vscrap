{
  "expo": {
    "name": "VScrap",
    "slug": "VScrap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vscrap",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "VScrap needs access to your photo library to save downloaded media.",
        "NSPhotoLibraryUsageDescription": "VScrap needs access to your photo library to save downloaded photos and videos."
      },
      "bundleIdentifier": "com.anonymous.VScrap"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E1E1C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "package": "com.anonymous.VScrap"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E1E1C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 110
        }
      ],
      "expo-file-system",
      "expo-media-library",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
